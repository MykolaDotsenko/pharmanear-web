{
  "framework": null,
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; connect-src 'self' https://overpass-api.de https://overpass.private.coffee; frame-src https://www.openstreetmap.org; base-uri 'none'; frame-ancestors 'none'; object-src 'none'; form-action 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(), microphone=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/data/current-finland-pharmacies.json",
      "destination": "https://raw.githubusercontent.com/MykolaDotsenko/pharmanear-web/main/data/finland-pharmacies.json"
    }
  ]
}
